# Copy to .env.local and fill in your Supabase project values.
# Only the PUBLISHABLE (anon) key belongs here — never the secret key.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → anon / publishable key (starts with sb_publishable_ or eyJ…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: direct link to the Termi.dmg release asset.
# Defaults to the GitHub releases page if unset.
# NEXT_PUBLIC_DMG_URL=https://github.com/vansh1sh/SuperTerminalApp/releases/latest/download/Termi.dmg

# Optional: canonical site origin for metadata/sitemap/robots (no trailing slash).
# Auto-detected from Vercel env if unset; set this for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://termi.app

# Enterprise demo requests. Configure either a secure webhook or Resend.
# The browser opens a prepared email if neither delivery method is configured.
# DEMO_REQUEST_WEBHOOK_URL=https://hooks.example.com/termi-demo
# DEMO_REQUEST_WEBHOOK_SECRET=replace-with-a-long-random-secret
# RESEND_API_KEY=re_...
# DEMO_REQUEST_RECIPIENT=vanshbadkul@gmail.com
# DEMO_REQUEST_FROM=Termi demos <demos@your-verified-domain.com>
# NEXT_PUBLIC_DEMO_EMAIL=vanshbadkul@gmail.com
